{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musafir-fast-food-api",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_CLOUDFLARE_HYPERDRIVE_ID"
    }
  ]
}
