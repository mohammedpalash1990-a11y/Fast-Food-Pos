{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fast-food-pos",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/menu",
      "/menu/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "648d6edd5ed9447889a9d3ddda7c7194"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
