DATABASE_URL=postgresql://musafir:change-me@localhost:5432/musafir_pos
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
CORS_ORIGIN=http://localhost:5173
PUBLIC_MENU_BASE_URL=http://localhost:5173/menu
SEED_ADMIN_EMAIL=admin@musafir.local
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!

# Production (Render + Neon)
NEON_DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
# Legacy Render -> Neon transfer (see docs/legacy-transfer-runbook.md).
# The legacy source above (DATABASE_URL) is only ever read.
# Dry run by default. A real migration needs BOTH:
#   1. npm run db:transfer:commit   (or --commit)
#   2. LEGACY_TRANSFER_COMMIT=true
LEGACY_TRANSFER_COMMIT=false
# Optional tuning for schema/value reconciliation
LEGACY_TRANSFER_BATCH_SIZE=300
LEGACY_TRANSFER_IGNORE_TABLES=
LEGACY_TRANSFER_ALLOW_UNSUPPORTED_TABLES=false
LEGACY_TRANSFER_ADD_MISSING_COLUMNS=false
LEGACY_TRANSFER_REPAIR_DUPLICATES=false
LEGACY_TRANSFER_CONFLICT=abort
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BOOTSTRAP_RESTAURANT_NAME=Musafir Fast Food
BOOTSTRAP_BRANCH_NAME=Main Branch
